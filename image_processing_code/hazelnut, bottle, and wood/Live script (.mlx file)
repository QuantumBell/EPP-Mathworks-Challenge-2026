% -------------------------------------------------------------------- HAZELNUT --------------------------------------------------------------------------------------

% NOTE: hz = hazelnut

hzFolder = "C:\Users\Molly\OneDrive\Documents\MATLAB EPP\mvtec_anomaly_detection_USED_v3\hazelnut";

hz_failFolder = fullfile(hzFolder, "FAIL");

% Select one crack image and one hole image.
hz_crackFolder = fullfile(hz_failFolder, "crack");
hz_holeFolder = fullfile(hz_failFolder, "hole");

hz_crackImds = imageDatastore(hz_crackFolder);
hz_holeImds = imageDatastore(hz_holeFolder);

% Read one image from each defect folder.
hz_crackImg = readimage(hz_crackImds, 18);
hz_holeImg = readimage(hz_holeImds, 15);

% Apply the same single-image inspection function to both defects.
[hz_crackMask, crackEvidence, hz_crackROI, hz_crackROIRGB, hz_crackOverlay] = inspectHazelnut(hz_crackImg);
[hz_holeMask, holeEvidence, hz_holeROI, hz_holeROIRGB, hz_holeOverlay] = inspectHazelnut(hz_holeImg);

% Crack mask.
figure;
imshowpair(hz_crackROI, hz_crackMask, "montage");
title("Hazelnut Crack: Image vs. Evidence Mask");

% Crack overlay.
figure;
imshowpair(hz_crackROIRGB, hz_crackOverlay, "montage");
title("Hazelnut Crack: ROI vs. Red Evidence Overlay");

% Hole mask.
figure;
imshowpair(hz_holeROI, hz_holeMask, "montage");
title("Hazelnut Hole: Image vs. Evidence Mask");

% Hole overlay.
figure;
imshowpair(hz_holeROIRGB, hz_holeOverlay, "montage");
title("Hazelnut Hole: ROI vs. Red Evidence Overlay");

fprintf("\nHazelnut crack metrics:\n");
fprintf("Number of suspicious regions: %d\n", crackEvidence.numComponents);
fprintf("Size of largest suspicious region: %d pixels\n", crackEvidence.maxArea);
fprintf("Area ratio: %.4f\n", crackEvidence.areaRatio);

fprintf("\nHazelnut hole metrics:\n");
fprintf("Number of suspicious regions: %d\n", holeEvidence.numComponents);
fprintf("Size of largest suspicious region: %d pixels\n", holeEvidence.maxArea);
fprintf("Area ratio: %.4f\n", holeEvidence.areaRatio);

