% -------------------------------------------------------------------- HAZELNUT --------------------------------------------------------------------------------------

% NOTE: hz = hazelnut

hzFolder = "C:\Users\Molly\OneDrive\Documents\MATLAB EPP\mvtec_anomaly_detection_USED_v3\hazelnut";

hz_failFolder = fullfile(hzFolder, "FAIL");

% Select one defect image (crack, hole, cut, & print).
hz_crackFolder = fullfile(hz_failFolder, "crack");
hz_holeFolder = fullfile(hz_failFolder, "hole");
hz_cutFolder = fullfile(hz_failFolder, "cut");
hz_printFolder = fullfile(hz_failFolder, "print");

hz_crackImds = imageDatastore(hz_crackFolder);
hz_holeImds = imageDatastore(hz_holeFolder);
hz_cutImds = imageDatastore(hz_cutFolder);
hz_printImds = imageDatastore(hz_printFolder);

% Read one image from each defect folder.
hz_crackImg = readimage(hz_crackImds, 1);
hz_holeImg = readimage(hz_holeImds, 1);
hz_cutImg = readimage(hz_cutImds, 1);
hz_printImg = readimage(hz_printImds, 1);

% Apply the same hazelnut inspection function using the dark- or bright-defect segmentation branch.
[hz_crackMask, hz_crackEvidence, hz_crackROI, hz_crackROIRGB, hz_crackOverlay] = inspectHazelnut(hz_crackImg, "dark");
[hz_holeMask, hz_holeEvidence, hz_holeROI, hz_holeROIRGB, hz_holeOverlay] = inspectHazelnut(hz_holeImg, "dark");

[hz_cutMask, hz_cutEvidence, hz_cutROI, hz_cutROIRGB, hz_cutOverlay] = inspectHazelnut(hz_cutImg, "bright");
[hz_printMask, hz_printEvidence, hz_printROI, hz_printROIRGB, hz_printOverlay] = inspectHazelnut(hz_printImg, "bright");

% Crack overlay.
%figure;
%imshow(hz_crackOverlay)
%title("Hazelnut Crack: Red Evidence Overlay");

% Hole overlay.
%figure;
%imshow(hz_holeOverlay)
%title("Hazelnut Hole: Red Evidence Overlay");

% Cut overlay.
%figure;
%imshow(hz_cutOverlay)
%title("Hazelnut Cut: Red Evidence Overlay");

% Print overlay.
%figure;
%imshow(hz_printOverlay)
%title("Hazelnut Print: Red Evidence Overlay");

% Interpretable metrics for crack, hole, cut, & print:

%fprintf("\nHazelnut crack metrics:\n");
%fprintf("Number of suspicious regions: %d\n", hz_crackEvidence.numComponents);
%fprintf("Size of largest suspicious region: %d pixels\n", hz_crackEvidence.maxArea);
%fprintf("Area ratio: %.4f\n", hz_crackEvidence.areaRatio);

%fprintf("\nHazelnut hole metrics:\n");
%fprintf("Number of suspicious regions: %d\n", hz_holeEvidence.numComponents);
%fprintf("Size of largest suspicious region: %d pixels\n", hz_holeEvidence.maxArea);
%fprintf("Area ratio: %.4f\n", hz_holeEvidence.areaRatio);

%fprintf("\nHazelnut cut metrics:\n");
%fprintf("Number of suspicious regions: %d\n", hz_cutEvidence.numComponents);
%fprintf("Size of largest suspicious region: %d pixels\n", hz_cutEvidence.maxArea);
%fprintf("Area ratio: %.4f\n", hz_cutEvidence.areaRatio);

%fprintf("\nHazelnut print metrics:\n");
%fprintf("Number of suspicious regions: %d\n", hz_printEvidence.numComponents);
%fprintf("Size of largest suspicious region: %d pixels\n", hz_printEvidence.maxArea);
%fprintf("Area ratio: %.4f\n", hz_printEvidence.areaRatio);

